# ~/.config/reprodroid-runner/runner.env へコピー。接続方式は docs/networking-and-pairing.md を参照。
# 以下は ADB reverse 用。LAN 接続では HOST と ADVERTISED_ENDPOINT を変更する。
REPRODROID_TRANSPORT_MODE=PAIRED_HTTPS
REPRODROID_HOST=127.0.0.1
REPRODROID_PORT=8443
REPRODROID_ADVERTISED_ENDPOINT=https://127.0.0.1:8443
REPRODROID_ENABLE_REAL_BUILDS=false
REPRODROID_BUILD_SANDBOX=DOCKER
