<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="RUNNER_STATE_DIRECTORY"
              value="${reprodroid.runner.stateDirectory:-${REPRODROID_STATE_DIR:-${user.home}/.local/state/reprodroid-runner}}" />

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%date{ISO8601} %-5level [%thread] %logger{36} - %message%n</pattern>
        </encoder>
    </appender>

    <appender name="RUNNER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${RUNNER_STATE_DIRECTORY}/runner.log</file>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%date{ISO8601} %-5level [%thread] %logger{36} - %message%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${RUNNER_STATE_DIRECTORY}/runner.log.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>512KB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>4MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- Only messages emitted by Runner code are persisted; third-party logs remain console-only. -->
    <logger name="ReproDroidRunner" level="INFO" additivity="true">
        <appender-ref ref="RUNNER_FILE" />
    </logger>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
